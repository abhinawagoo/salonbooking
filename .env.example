# Database (PostgreSQL – use Neon, Vercel Postgres, or Supabase for dev and production)
# Example Neon: https://neon.tech → Create project → copy connection string
# IMPORTANT for Neon: Add connect_timeout & pool_timeout to avoid P1001 "Can't reach database" (cold starts)
# Neon scales to zero after 5 min; first request after idle needs extra time to wake. Use pooler URL (-pooler in host).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&connect_timeout=30&pool_timeout=30"

# JWT Secret
JWT_SECRET="your-secret-key-change-in-production"

# PhonePe PG (current API: OAuth + v2) – https://developer.phonepe.com/payment-gateway/website-integration/standard-checkout/api-integration/integration-steps
# Get credentials from PhonePe Business Dashboard → Developer Settings.
# Sandbox: https://api-preprod.phonepe.com/apis/pg-sandbox/<Endpoint>
# Production: Auth → https://api.phonepe.com/apis/identity-manager/<Endpoint>, Other → https://api.phonepe.com/apis/pg/<Endpoint>
# Steps: 1) Authorization POST /v1/oauth/token 2) Create Payment POST /checkout/v2/pay 3) Invoke PayPage (iframe/redirect) 4) Verify via Webhook + Order Status
PHONEPE_CLIENT_ID=""
PHONEPE_CLIENT_SECRET=""
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV="sandbox"
# Webhook (recommended): PhonePe Dashboard → Webhook URL = https://YOUR_DOMAIN/api/payment/webhook
# Auth: Authorization = SHA256(username:password) as hex (PhonePe sends this). Use strong random values—not your email.
# Generate (run twice for two different strings): openssl rand -hex 32
# Paste the same username + password into PhonePe Webhook settings and here.
PHONEPE_WEBHOOK_USERNAME=""
PHONEPE_WEBHOOK_PASSWORD=""

# Use Test Payment: set "true" in Vercel for production testing (no real payment)
# When true, Pay Now completes instantly without PhonePe redirect
USE_TEST_PAYMENT="false"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Disable login/signup (set to "true" to hide auth and avoid redirects to login while testing e.g. payment)
NEXT_PUBLIC_DISABLE_AUTH="false"

# Cloudflare R2 – media storage (banner, videos, service images, gallery)
# When set, uploads go to R2 instead of local public/uploads
# See docs/R2_SETUP.md for step-by-step setup
R2_ACCOUNT_ID=""           # R2 page → right sidebar
R2_ACCESS_KEY_ID=""        # Manage R2 API Tokens → Create token → Object Read & Write
R2_SECRET_ACCESS_KEY=""    # Same token (secret shown once)
R2_BUCKET_NAME="salon-media"
R2_PUBLIC_URL=""           # Bucket public URL, e.g. https://pub-xxxxx.r2.dev (no trailing slash)

# Hero section: optional video URL (leave empty for gradient banner)
NEXT_PUBLIC_HERO_VIDEO_URL="https://pub-d258b226bfee42f09be50feec338e732.r2.dev/36e606be-80c0-4276-bb11-2953cbc270f1/documents/IMG_1005.mp4"

# WhatsApp Cloud API (direct, no BSP) – OTP + booking confirmation + invoice + booking notify
# Error #131030? Add recipient to Meta Console → WhatsApp → API Setup → Manage phone number list
# NOTIFY_STAFF_ON_BOOKING="false" – skip staff notifications (avoids errors for seeded 9999999999/8888888888 in dev)
# Error #132001? Check template name and language. See docs/WHATSAPP_TROUBLESHOOTING.md
# Meta: developers.facebook.com → App → WhatsApp → Get Phone Number ID + Access Token
# OTP: Create authentication template (Copy Code) in Meta. Body: "{{1}} is your verification code."
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_LANG="en_US"
# OTP template name (create in Meta Template Library → Authentication → Copy Code)
WHATSAPP_OTP_TEMPLATE_NAME="otp_verification"
# Set true to send real OTP via WhatsApp in dev (otherwise use 1234)
USE_WHATSAPP_OTP="true"
WHATSAPP_OTP_EXPIRY_MINUTES="10"
# Invoice Utility template – see docs/WHATSAPP_INVOICE_UTILITY_TEMPLATE.md
WHATSAPP_INVOICE_TEMPLATE_NAME="customer_invoice"
# Public HTTPS image URL for Meta IMAGE header (required each send; sample in Meta is not used). Omit to use built-in default; set "" to skip header (legacy body-only template).
# WHATSAPP_INVOICE_HEADER_IMAGE_URL="https://..."
# If invoice template language in Meta is en_US, set this (overrides WHATSAPP_TEMPLATE_LANG for invoice only)
# WHATSAPP_INVOICE_TEMPLATE_LANG="en_US"
WHATSAPP_INVOICE_TEMPLATE_LEGACY="false"
# Button URL in Meta is like https://shahnazsalonsasaram.com/booking/invoice?token={{1}} — app sends TOKEN only (default). Set true only if button expects full URL.
WHATSAPP_INVOICE_BUTTON_FULL_URL="false"
# Legacy template only (WHATSAPP_INVOICE_TEMPLATE_LEGACY=true):
WHATSAPP_INVOICE_BILL_TYPE="booking for Shahnaz Salon Sasaram"
# Use hello_world template for testing when business verification pending (no custom templates yet)
# USE_WHATSAPP_HELLO_WORLD_TEST="true"
# Booking confirmation: Header "Your appointment is booked", Body "Hello {{1}}, Thank you for booking... Your appointment for {{2}} on {{3}} at {{4}} is confirmed."
# Params: {{1}} name, {{2}} services, {{3}} date (Dec 31, 2025), {{4}} time (1:00 PM). Set HAS_HEADER=false if template has no header.
WHATSAPP_BOOKING_TEMPLATE_NAME="booking_confirmation"
WHATSAPP_BOOKING_TEMPLATE_HAS_HEADER="true"
# Staff/manager alert when a booking is created (body-only template, 7 variables — see docs/WHATSAPP_STAFF_BOOKING_TEMPLATE.md)
WHATSAPP_STAFF_BOOKING_TEMPLATE_NAME="staff_booking_alert"
# When WhatsApp not set up: LOG_OTP_WHEN_NO_WHATSAPP=true logs OTP to console for testing

# --- Optional providers (not used; booking notify uses WhatsApp Cloud API only) ---
# # MSG91 / 360dialog – see git history if you re-enable BSP + SMS

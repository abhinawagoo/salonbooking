# Database (PostgreSQL – use Neon, Vercel Postgres, or Supabase for dev and production)
# Example Neon: https://neon.tech → Create project → copy connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Secret
JWT_SECRET="your-secret-key-change-in-production"

# PhonePe PG (current API: OAuth + v2) – https://developer.phonepe.com/payment-gateway/website-integration/standard-checkout/api-integration/integration-steps
# Get credentials from PhonePe Business Dashboard → Developer Settings.
# Sandbox: https://api-preprod.phonepe.com/apis/pg-sandbox/<Endpoint>
# Production: Auth → https://api.phonepe.com/apis/identity-manager/<Endpoint>, Other → https://api.phonepe.com/apis/pg/<Endpoint>
# Steps: 1) Authorization POST /v1/oauth/token 2) Create Payment POST /checkout/v2/pay 3) Invoke PayPage (iframe/redirect) 4) Verify via Webhook + Order Status
PHONEPE_CLIENT_ID=""
PHONEPE_CLIENT_SECRET=""
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV="sandbox"
# Webhook (recommended): configure same in Dashboard → Developer Settings → Webhook. Auth header = SHA256(username:password).
PHONEPE_WEBHOOK_USERNAME=""
PHONEPE_WEBHOOK_PASSWORD=""

# Use Test Payment (set to "true" to always use test payment, even in production for testing)
USE_TEST_PAYMENT="false"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Disable login/signup (set to "true" to hide auth and avoid redirects to login while testing e.g. payment)
NEXT_PUBLIC_DISABLE_AUTH="false"

# Cloudflare R2 (optional – for service images, hero videos, gallery)
# When set, uploads go to R2 instead of local public/uploads
# Create bucket in Cloudflare Dashboard → R2 → Create bucket → enable Public access → copy Public bucket URL
# Create API token: R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
# R2_PUBLIC_URL="https://pub-xxx.r2.dev"  # Public bucket URL or custom domain
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="salon-media"
# R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# Hero section: optional video URL (leave empty for gradient banner)
NEXT_PUBLIC_HERO_VIDEO_URL="https://pub-d258b226bfee42f09be50feec338e732.r2.dev/36e606be-80c0-4276-bb11-2953cbc270f1/documents/IMG_1005.mp4"

# Notifications: WhatsApp + SMS (no Twilio – use MSG91 or direct Meta BSP)
# Provider: "msg91" (India, WhatsApp + SMS, cheap) or "360dialog" (direct Meta BSP, WhatsApp only)
NOTIFY_PROVIDER="msg91"

# WhatsApp Cloud API (direct, no BSP) – OTP + invoice link sent to customer mobile
# Meta: developers.facebook.com → App → WhatsApp → Get Phone Number ID + Access Token
# OTP: Create authentication template (Copy Code) in Meta. Body: "{{1}} is your verification code."
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_LANG="en"
# OTP template name (create in Meta Template Library → Authentication → Copy Code)
WHATSAPP_OTP_TEMPLATE_NAME="otp_verification"
WHATSAPP_OTP_EXPIRY_MINUTES="10"
# Invoice template: "Hi {{1}}, your booking payment is confirmed. View & download invoice: {{2}}"
WHATSAPP_INVOICE_TEMPLATE_NAME="invoice_ready"

# MSG91 (India): https://msg91.com – low cost, no markup over Meta for WhatsApp
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="SALON"
# Optional: create template in MSG91 panel and set ID for WhatsApp; else only SMS is sent
# MSG91_WHATSAPP_TEMPLATE_ID=""

# 360dialog: https://360dialog.com – direct Meta BSP, WhatsApp only (no markup on Meta fees)
# Use with MSG91_AUTH_KEY for SMS fallback
# DIALOG360_API_KEY=""
# DIALOG360_TEMPLATE_LANG="en"
# NOTIFY_WHATSAPP_TEMPLATE_NAME="booking_confirmation"

# Optional: always send SMS in addition to WhatsApp
# NOTIFY_ALWAYS_SMS="false"

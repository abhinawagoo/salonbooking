# Database
# For SQLite (development):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/salonbooking?schema=public"

# JWT Secret
JWT_SECRET="your-secret-key-change-in-production"

# PhonePe Configuration
PHONEPE_MERCHANT_ID="your-merchant-id"
PHONEPE_SALT_KEY="your-salt-key"
PHONEPE_SALT_INDEX=1
PHONEPE_ENV="sandbox" # or "production"

# Use Test Payment (set to "true" to always use test payment, even in production for testing)
USE_TEST_PAYMENT="false"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 (optional – for service images, hero videos, gallery)
# When set, uploads go to R2 instead of local public/uploads
# Create bucket in Cloudflare Dashboard → R2 → Create bucket → enable Public access → copy Public bucket URL
# Create API token: R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
# R2_PUBLIC_URL = Public bucket URL (e.g. https://pub-xxx.r2.dev or custom domain)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="salon-media"
# R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# Hero section: optional video URL (leave empty for gradient banner)
NEXT_PUBLIC_HERO_VIDEO_URL="https://pub-d258b226bfee42f09be50feec338e732.r2.dev/36e606be-80c0-4276-bb11-2953cbc270f1/documents/IMG_1005.mp4"

# Notifications: WhatsApp + SMS (no Twilio – use MSG91 or direct Meta BSP)
# Provider: "msg91" (India, WhatsApp + SMS, cheap) or "360dialog" (direct Meta BSP, WhatsApp only)
NOTIFY_PROVIDER="msg91"

# MSG91 (India): https://msg91.com – low cost, no markup over Meta for WhatsApp
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="SALON"
# Optional: create template in MSG91 panel and set ID for WhatsApp; else only SMS is sent
# MSG91_WHATSAPP_TEMPLATE_ID=""

# 360dialog: https://360dialog.com – direct Meta BSP, WhatsApp only (no markup on Meta fees)
# Use with MSG91_AUTH_KEY for SMS fallback
# DIALOG360_API_KEY=""
# DIALOG360_TEMPLATE_LANG="en"
# NOTIFY_WHATSAPP_TEMPLATE_NAME="booking_confirmation"

# Optional: always send SMS in addition to WhatsApp
# NOTIFY_ALWAYS_SMS="false"
